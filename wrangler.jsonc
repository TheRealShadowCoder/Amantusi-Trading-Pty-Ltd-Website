{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amantusi-trading-pty-ltd-site",
  "account_id": "3b4dba2eec2c69b95eae20d70941e9b2",
  "compatibility_date": "2026-08-16",
  "main": "./src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/media/*"]
  },
  "kv_namespaces": [
    {
      "binding": "CMS_KV"
    }
  ]
}
